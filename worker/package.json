{
  "name": "voidmail",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create voidmail",
    "db:migrate": "wrangler d1 execute voidmail --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute voidmail --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postal-mime": "^2.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.28.0"
  }
}
